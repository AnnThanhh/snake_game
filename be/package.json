{
  "name": "serpent-backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ops:logs": "node --env-file-if-exists=.env scripts/read-logs.js",
    "test:operations": "node --env-file=.env --test tests/operations.integration.js",
    "test:soak:http": "node --env-file-if-exists=.env scripts/http-soak.js",
    "setup": "node scripts/setup.js",
    "build": "node --env-file-if-exists=.env scripts/build.js",
    "start": "node --env-file-if-exists=.env scripts/start.js",
    "dev": "npm run build && npm start",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "admin:bootstrap": "node --env-file=.env scripts/bootstrap-admin.js",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "infra:status": "docker compose ps",
    "monitoring:up": "node scripts/setup-monitoring.js && docker compose --profile monitoring up -d --wait",
    "test": "node --test tests/*.test.js",
    "test:backend": "node --env-file=.env --test tests/backend.integration.js",
    "test:admin": "node --env-file=.env --test tests/admin.integration.js",
    "test:queue": "node --env-file=.env --test tests/queue.integration.js",
    "test:docker": "node --env-file=.env scripts/docker-persistence-test.js",
    "test:load": "node --env-file=.env scripts/v2-load-test.js",
    "test:capacity": "node --env-file=.env scripts/capacity-test.js",
    "benchmark": "node scripts/benchmark.js --json",
    "test:authority": "node --env-file=.env --test tests/authority.integration.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.51",
    "@colyseus/redis-driver": "^0.17.7",
    "@colyseus/redis-presence": "^0.17.8",
    "@colyseus/ws-transport": "^0.17.13",
    "@nestjs/common": "^11.2.5",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-fastify": "^11.2.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.8",
    "express": "^5.2.1",
    "fastify": "5.12.5",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "typescript": "5.9",
    "@colyseus/sdk": "^0.17.43"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "overrides": {
    "fastify": "5.12.5",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
