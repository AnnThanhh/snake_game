# npm run setup generates a .env containing random credentials.
POSTGRES_PASSWORD=replace_with_random_secret
REDIS_PASSWORD=replace_with_random_secret
POSTGRES_PORT=54329
REDIS_PORT=16379
DATABASE_URL=postgresql://serpent:replace_with_random_secret@127.0.0.1:54329/serpent
REDIS_URL=redis://:replace_with_random_secret@127.0.0.1:16379
BACKEND_PORT=3001
BACKEND_URL=http://127.0.0.1:3001
GAME_SERVER_SECRET=replace_with_random_secret
ARENA_CAPACITY=10
# Optional infrastructure log destination. npm start defaults to be/.data/logs.
# LOG_DIR=.data/logs
# Set a unique instance name if multiple processes of the same service share LOG_DIR.
# LOG_INSTANCE=node1
