{
  "name": "serpent-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ops:logs": "node --env-file-if-exists=.env scripts/read-logs.js",
    "dev": "vite --configLoader native",
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:seo": "node scripts/browser-seo-test.js",
    "test:security": "node scripts/browser-security-test.js",
    "test:browser": "node scripts/browser-test.js",
    "test:browser:v2": "node scripts/browser-v2-test.js",
    "test:browser:admin": "node scripts/browser-admin-test.js"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9",
    "vite": "^7.3.6",
    "playwright": "^1.58.2",
    "@types/node": "^26.6.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
